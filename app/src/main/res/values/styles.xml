<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.ProofNest.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/proofnest_surface</item>
    </style>

    <style name="Widget.ProofNest.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/proofnest_secondary</item>
        <item name="tint">@color/proofnest_primary_dark</item>
        <item name="shapeAppearance">@style/ShapeAppearance.ProofNest.Fab</item>
    </style>

    <style name="ShapeAppearance.ProofNest.Fab" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="TextAppearance.ProofNest.CardTitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/proofnest_on_surface</item>
    </style>

    <style name="TextAppearance.ProofNest.Muted" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/proofnest_on_surface_muted</item>
    </style>

    <style name="ShapeAppearance.ProofNest.SmallComponent" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">10dp</item>
    </style>

    <style name="Widget.ProofNest.RoleToggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/role_toggle_bg</item>
        <item name="strokeColor">@color/role_toggle_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/role_toggle_text</item>
        <item name="shapeAppearance">@style/ShapeAppearance.ProofNest.SmallComponent</item>
    </style>

    <style name="Widget.ProofNest.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">24dp</item>
        <item name="itemPaddingTop">4dp</item>
        <item name="itemPaddingBottom">4dp</item>
    </style>
</resources>

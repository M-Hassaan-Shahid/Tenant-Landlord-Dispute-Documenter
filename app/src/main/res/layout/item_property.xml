<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/card_margin"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    style="@style/Widget.ProofNest.Card"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/propertyThumb"
            android:layout_width="@dimen/property_thumb_size"
            android:layout_height="@dimen/property_thumb_size"
            android:background="@drawable/bg_property_thumb"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iconProperty"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                app:tint="@color/proofnest_primary"
                tools:src="@drawable/ic_home" />
        </FrameLayout>

        <TextView
            android:id="@+id/textAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textAppearance="@style/TextAppearance.ProofNest.CardTitle"
            app:layout_constraintEnd_toStartOf="@id/chipStatus"
            app:layout_constraintStart_toEndOf="@id/propertyThumb"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="42 Gulberg III, Lahore" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStatus"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipMinHeight="28dp"
            app:layout_constraintEnd_toStartOf="@id/iconChevron"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Active" />

        <ImageView
            android:id="@+id/iconChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/proofnest_on_surface_muted" />

        <TextView
            android:id="@+id/textRole"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="28dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/propertyThumb"
            app:layout_constraintTop_toBottomOf="@id/textAddress"
            tools:text="Landlord · Move-in in progress" />

        <TextView
            android:id="@+id/textRent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="28dp"
            android:textAppearance="@style/TextAppearance.ProofNest.Muted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/propertyThumb"
            app:layout_constraintTop_toBottomOf="@id/textRole"
            tools:text="PKR 45,000/mo · Deposit PKR 90,000" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/proofnest_surface"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/content_padding"
    android:paddingTop="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/inspection_progress_label"
            android:textAppearance="@style/TextAppearance.ProofNest.Muted" />

        <TextView
            android:id="@+id/textProgressPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.ProofNest.Muted"
            tools:text="40%" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressInspection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:indeterminate="false"
        app:indicatorColor="@color/proofnest_primary"
        app:trackColor="@color/proofnest_surface_variant"
        app:trackCornerRadius="4dp"
        app:trackThickness="8dp"
        tools:progress="40" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base: brand green gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/proofnest_primary"
                android:centerColor="@color/proofnest_primary"
                android:endColor="@color/proofnest_primary_dark" />
        </shape>
    </item>

    <!-- Decorative geometric pattern overlay -->
    <item android:drawable="@drawable/pattern_toolbar" />
</layer-list>

# =============================================================================
# ProofNest — Android + Firebase
# =============================================================================

# --- Built outputs (Gradle); deliverable APKs live in releases/ ---
*.apk
!releases/*.apk
*.ap_
*.aab
*.aar
*.dex
*.class

bin/
gen/
out/
release/

# --- Gradle ---
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# --- Local machine config (never commit) ---
local.properties
*.properties.bak

# --- Android Studio / IntelliJ IDEA ---
*.iml
.idea/
!.idea/codeStyles/
!.idea/runConfigurations.xml
!.idea/inspectionProfiles/

# --- Kotlin ---
.kotlin/

# --- Android tooling ---
.navigation/
.externalNativeBuild/
.cxx/
captures/
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# --- OS junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~
*.swp
*.swo
*.bak
*.orig
*.rej

# --- Logs & crash dumps ---
*.log
*.hprof
hs_err_pid*

# --- Firebase (CLI, emulators, functions) ---
.firebase/
firebase-debug.log
firebase-debug.*.log
ui-debug.log
database-debug.log
pubsub-debug.log
firestore-debug.log
firebase/functions/node_modules/
firebase/firestore-tests/node_modules/
firebase/functions/lib/
firebase/functions/.runtimeconfig.json

# --- Secrets & signing (never commit) ---
*.jks
*.keystore
key.properties
**/service-account*.json
**/credentials.json
.env
.env.*
.env.local

# Firebase Android config — download from Firebase Console per machine / developer
app/google-services.json

# --- Optional local-only artifacts ---
docs/*.pdf
scripts/
